{
  "name": "cvec",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://cvec.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/swolg/cvec-app.git"
  },
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "contract:check": "node scripts/check-ipc-contract.mjs",
    "dependency:check": "node scripts/check-dependency-policy.mjs",
    "osv:check": "node scripts/check-osv-results.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "check": "npm run dependency:check && npm run licenses:check && npm run contract:check && npm run ui:inventory && npm run test:local-tools && npm run test:run && npm run build && npm run performance:frontend",
    "performance:frontend": "node scripts/check-frontend-budget.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "ui:inventory": "node scripts/ui-inventory.mjs --strict",
    "signing:setup": "node scripts/local-signing.mjs setup",
    "signing:doctor": "node scripts/local-signing.mjs doctor",
    "signing:smoke": "node scripts/local-signing.mjs smoke",
    "test:local-tools": "node --test scripts/local-signing.node-test.mjs scripts/generate-sbom.node-test.mjs scripts/license-inventory.node-test.mjs scripts/check-osv-results.node-test.mjs scripts/check-performance.node-test.mjs scripts/provider-live-smoke.node-test.mjs",
    "licenses:generate": "node scripts/license-inventory.mjs generate",
    "licenses:check": "node scripts/license-inventory.mjs check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.12.4",
    "@visx/group": "4.0.1-alpha.0",
    "@visx/shape": "4.0.1-alpha.0",
    "@visx/text": "4.0.1-alpha.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-markdown": "10.1.0",
    "react-resizable": "4.0.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
